+package xiaohongshu
+
+import (
+	"context"
+	"errors"
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/launcher"
+	"net/url"
+	"os"
+	"testing"
+	"time"
+)
+
+// Local deterministic fixtures, never real account data or platform requests.
+func TestSearchDataReadiness(t *testing.T) {
+	bin := os.Getenv("XHS_TEST_BROWSER_BIN")
+	if bin == "" {
+		t.Skip("set XHS_TEST_BROWSER_BIN for local browser regression fixtures")
+	}
+	l := launcher.New().Bin(bin).Headless(true).UserDataDir(t.TempDir())
+	browser := rod.New().ControlURL(l.MustLaunch()).MustConnect()
+	defer l.Cleanup()
+	defer browser.Close()
+	newPage := func(t *testing.T, script string) *rod.Page {
+		t.Helper()
+		p := browser.MustPage("data:text/html," + url.PathEscape("<body><script>"+script+"</script></body>"))
+		t.Cleanup(func() { _ = p.Close() })
+		p.MustWaitLoad()
+		return p
+	}
+	t.Run("background DOM activity does not block ready results", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'success'},feeds:{value:[{id:'fixture'}]}}}; setInterval(()=>document.body.textContent=String(Date.now()),10);`)
+		start := time.Now()
+		_ = p.Timeout(350 * time.Millisecond).WaitStable(50 * time.Millisecond)
+		if time.Since(start) < 300*time.Millisecond {
+			t.Fatal("fixture did not reproduce the old whole-page wait")
+		}
+		if err := waitSearchData(p.Timeout(time.Second)); err != nil {
+			t.Fatal("ready data blocked by unrelated DOM activity")
+		}
+	})
+	t.Run("initial empty array waits for finished search", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'loading'},feeds:{value:[]}}};setTimeout(()=>{window.__INITIAL_STATE__.search.feeds.value=[{id:'fixture'}];window.__INITIAL_STATE__.search.state.value='success';},200);`)
+		if err := waitSearchData(p.Timeout(2 * time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		if p.MustEval(`()=>window.__INITIAL_STATE__.search.feeds.value.length`).Int() != 1 {
+			t.Fatal("loading empty array was treated as finished")
+		}
+	})
+	t.Run("completed empty search returns", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'success'},feeds:{value:[]}}};`)
+		if err := waitSearchData(p.Timeout(time.Second)); err != nil {
+			t.Fatal("completed empty result was not accepted")
+		}
+	})
+	t.Run("failed search is not an empty result", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'error'},feeds:{value:[]}}};`)
+		if err := waitSearchData(p.Timeout(time.Second)); err == nil {
+			t.Fatal("failed search accepted")
+		}
+	})
+	t.Run("cancel loading search", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'loading'},feeds:{value:[]}}};`)
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		if err := waitSearchData(p.Context(ctx)); !errors.Is(err, context.Canceled) {
+			t.Fatal("cancellation was lost")
+		}
+	})
+}
