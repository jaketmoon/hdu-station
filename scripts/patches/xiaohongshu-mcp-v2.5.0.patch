+// HDU Station local change (2026-09-11): avoid unrelated page-idle timeouts.
+// waitSearchData waits for the search store, not whole-page network/DOM idle.
+// A successful empty result is ready; the initial loading [] is not.
+func waitSearchData(page *rod.Page) error {
+	const ready = `() => {
+  const unref = x => x && typeof x === 'object' ? (x.value !== undefined ? x.value : x._value) : x;
+  const search = window.__INITIAL_STATE__?.search;
+  if (!search) return false;
+  const feeds = unref(search.feeds);
+  const phase = unref(search.state);
+  if (phase === 'error') return true;
+  return Array.isArray(feeds) && (phase === 'success' || (phase === undefined && feeds.length > 0));
+ }`
+	if err := page.Wait(rod.Eval(ready)); err != nil {
+		return fmt.Errorf("等待搜索结果失败: %w", err)
+	}
+	state, err := page.Eval(`() => {
+  const s = window.__INITIAL_STATE__?.search?.state;
+  return s && typeof s === 'object' ? (s.value !== undefined ? s.value : s._value) : s;
+ }`)
+	if err != nil {
+		return fmt.Errorf("读取搜索状态失败: %w", err)
+	}
+	if state.Value.Str() == "error" {
+		return fmt.Errorf("搜索页加载失败，请稍后重试")
+	}
+	return nil
+}
