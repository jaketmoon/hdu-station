@@ -0,0 +1,40 @@
+package main
+
+import (
+	"context"
+
+	"testing"
+	"time"
+)
+
+func TestSecurityExpiryAndStaleSessionCannotAuthorize(t *testing.T) {
+	service := &XiaohongshuService{}
+	closed := 0
+	service.security.id = "old"
+	service.security.status = "waiting"
+	service.security.close = func() { closed++ }
+	oldID := service.security.id
+	if !service.security.required() {
+		t.Fatal("challenge did not block searches")
+	}
+	service.security.expires = time.Now().Add(-time.Second)
+	result, err := service.securityPoll(context.Background(), oldID)
+	if err != nil || result.Status != "expired" || closed != 1 {
+		t.Fatal("expired browser was not closed", result, err, closed)
+	}
+	if !service.security.required() {
+		t.Fatal("expiration incorrectly restored search")
+	}
+	service.security.id = "new"
+	service.security.status = "waiting"
+	service.security.expires = time.Now().Add(time.Minute)
+	service.security.close = func() { closed++ }
+	result, err = service.securityPoll(context.Background(), oldID)
+	if err != nil || result.Status != "cancelled" || closed != 1 {
+		t.Fatal("stale poll changed new session")
+	}
+	service.security.clear()
+	if service.security.required() || closed != 2 {
+		t.Fatal("clear left a browser or challenge")
+	}
+}
