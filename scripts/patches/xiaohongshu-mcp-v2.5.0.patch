new file mode 100644
--- /dev/null
+++ b/xiaohongshu/search_ready_test.go
@@ -0,0 +1,82 @@
+package xiaohongshu
+
+import (
+	"context"
+	"errors"
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/launcher"
+	"net/url"
+	"os"
+	"testing"
+	"time"
+)
+
+// Local deterministic fixtures, never real account data or platform requests.
+func TestSearchDataReadiness(t *testing.T) {
+	bin := os.Getenv("XHS_TEST_BROWSER_BIN")
+	if bin == "" {
+		t.Skip("set XHS_TEST_BROWSER_BIN for local browser regression fixtures")
+	}
+	l := launcher.New().Bin(bin).Headless(true).UserDataDir(t.TempDir())
+	browser := rod.New().ControlURL(l.MustLaunch()).MustConnect()
+	defer l.Cleanup()
+	defer browser.Close()
+	newPage := func(t *testing.T, script string) *rod.Page {
+		t.Helper()
+		p := browser.MustPage("data:text/html," + url.PathEscape("<body><script>"+script+"</script></body>"))
+		t.Cleanup(func() { _ = p.Close() })
+		p.MustWaitLoad()
+		return p
+	}
+	t.Run("background DOM activity does not block ready results", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'success'},feeds:{value:[{id:'fixture'}]}}}; setInterval(()=>document.body.textContent=String(Date.now()),10);`)
+		start := time.Now()
+		_ = p.Timeout(350 * time.Millisecond).WaitStable(50 * time.Millisecond)
+		if time.Since(start) < 300*time.Millisecond {
+			t.Fatal("fixture did not reproduce the old whole-page wait")
+		}
+		if err := waitSearchData(p.Timeout(time.Second)); err != nil {
+			t.Fatal("ready data blocked by unrelated DOM activity")
+		}
+	})
+	t.Run("initial empty array waits for finished search", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'loading'},feeds:{value:[]}}};setTimeout(()=>{window.__INITIAL_STATE__.search.feeds.value=[{id:'fixture'}];window.__INITIAL_STATE__.search.state.value='success';},200);`)
+		if err := waitSearchData(p.Timeout(2 * time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		if p.MustEval(`()=>window.__INITIAL_STATE__.search.feeds.value.length`).Int() != 1 {
+			t.Fatal("loading empty array was treated as finished")
+		}
+	})
+	t.Run("completed empty search returns", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'success'},feeds:{value:[]}}};`)
+		if err := waitSearchData(p.Timeout(time.Second)); err != nil {
+			t.Fatal("completed empty result was not accepted")
+		}
+	})
+	t.Run("failed search is not an empty result", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'error'},feeds:{value:[]}}};`)
+		if err := waitSearchData(p.Timeout(time.Second)); err == nil {
+			t.Fatal("failed search accepted")
+		}
+	})
+	t.Run("security challenge returns immediately without becoming empty search", func(t *testing.T) {
+		p := newPage(t, `document.body.textContent='fixture';`)
+		router := p.HijackRequests()
+		router.MustAdd("https://www.xiaohongshu.com/*", func(h *rod.Hijack) { h.Response.SetBody("<body>安全验证</body>") })
+		go router.Run()
+		defer router.Stop()
+		p.MustNavigate("https://www.xiaohongshu.com/website-login/captcha")
+		if err := waitSearchData(p.Timeout(time.Second)); !errors.Is(err, ErrSecurityVerification) {
+			t.Fatal("security page was not distinguished", err)
+		}
+	})
+	t.Run("cancel loading search", func(t *testing.T) {
+		p := newPage(t, `window.__INITIAL_STATE__={search:{state:{value:'loading'},feeds:{value:[]}}};`)
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		if err := waitSearchData(p.Context(ctx)); !errors.Is(err, context.Canceled) {
+			t.Fatal("cancellation was lost")
+		}
+	})
+}
diff --git a/security_station.go b/security_station.go
new file mode 100644
--- /dev/null
+++ b/security_station.go
@@ -0,0 +1,201 @@
+package main
+
+// HDU Station settings-only security challenge. Keep the exact browser which
+// reached the challenge; never replace it with a login QR or expose its URL.
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-rod/rod"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+type securitySession struct {
+	mu         sync.Mutex
+	id, status string
+	page       *rod.Page
+	close      func()
+	expires    time.Time
+}
+type securityResult struct {
+	ID        string `json:"id"`
+	Status    string `json:"status"`
+	Image     string `json:"image,omitempty"`
+	ExpiresAt int64  `json:"expiresAt,omitempty"`
+}
+
+func (s *securitySession) required() bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.status != "" && s.status != "ready"
+}
+func (s *securitySession) closeLocked() {
+	if s.close != nil {
+		s.close()
+		s.close = nil
+		s.page = nil
+	}
+}
+func (s *securitySession) clear() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.closeLocked()
+	s.status = ""
+	s.id = ""
+}
+func (s *securitySession) retain(p *rod.Page, close func()) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.status == "waiting" && time.Now().Before(s.expires) {
+		return false
+	}
+	s.closeLocked()
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return false
+	}
+	s.id = hex.EncodeToString(nonce[:])
+	s.status = "waiting"
+	s.page = p.Context(context.Background())
+	s.close = close
+	// The website says its QR expires after one minute. Use a shorter local TTL.
+	s.expires = time.Now().Add(50 * time.Second)
+	id := s.id
+	time.AfterFunc(50*time.Second, func() {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		if s.id == id && s.status == "waiting" {
+			s.status = "expired"
+			s.closeLocked()
+		}
+	})
+	return true
+}
+func (s *securitySession) resultLocked() securityResult {
+	return securityResult{ID: s.id, Status: s.status, ExpiresAt: s.expires.UnixMilli()}
+}
+func (s *XiaohongshuService) securityQR(ctx context.Context) (securityResult, error) {
+	v := &s.security
+	v.mu.Lock()
+	active := v.status == "waiting" && time.Until(v.expires) > 10*time.Second
+	if !active {
+		v.closeLocked()
+		v.status = ""
+		v.id = ""
+	}
+	v.mu.Unlock()
+	if !active {
+		// Probe the actual read operation, not the home-page login indicator.
+		_, err := s.SearchFeeds(ctx, "杭电 选课")
+		if err == nil {
+			return securityResult{Status: "ready"}, nil
+		}
+		if !errors.Is(err, xiaohongshu.ErrSecurityVerification) {
+			return securityResult{}, err
+		}
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.page == nil {
+		return securityResult{Status: "expired"}, nil
+	}
+	page := v.page.Context(ctx).Timeout(8 * time.Second)
+	// Return only the site's own QR data image; no page URL or account data.
+	el, err := page.Element("img.qrcode-img")
+	if err != nil {
+		return securityResult{}, errors.New("安全验证二维码暂未加载")
+	}
+	src, err := el.Attribute("src")
+	if err != nil || src == nil {
+		return securityResult{}, errors.New("安全验证二维码暂未加载")
+	}
+	result := v.resultLocked()
+	result.Image = *src
+	return result, nil
+}
+func (s *XiaohongshuService) securityPoll(ctx context.Context, id string) (securityResult, error) {
+	v := &s.security
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if id == "" || id != v.id {
+		return securityResult{Status: "cancelled"}, nil
+	}
+	if v.status != "waiting" {
+		return v.resultLocked(), nil
+	}
+	if time.Now().After(v.expires) {
+		v.status = "expired"
+		v.closeLocked()
+		return v.resultLocked(), nil
+	}
+	page := v.page.Context(ctx).Timeout(8 * time.Second)
+	state, err := page.Eval(`() => ({captcha:location.pathname === '/website-login/captcha', passed:/验证成功/.test(document.body?.innerText || '')})`)
+	if err != nil {
+		return securityResult{}, errors.New("暂时无法检查安全验证")
+	}
+	if state.Value.Get("captcha").Bool() && !state.Value.Get("passed").Bool() {
+		return v.resultLocked(), nil
+	}
+	// A QR scan alone is insufficient: require a real successful search before
+	// persisting cookies or advertising recovery.
+	_, err = xiaohongshu.NewSearchAction(v.page).Search(ctx, "杭电 选课")
+	if errors.Is(err, xiaohongshu.ErrSecurityVerification) {
+		v.status = "expired"
+		v.closeLocked()
+		return v.resultLocked(), nil
+	}
+	if err != nil {
+		return securityResult{}, errors.New("验证后搜索仍不可用，请稍后重试")
+	}
+	if err = saveCookies(v.page.Context(ctx)); err != nil {
+		return securityResult{}, errors.New("无法保存验证状态")
+	}
+	v.status = "ready"
+	v.closeLocked()
+	return v.resultLocked(), nil
+}
+func (s *AppServer) securityQRHandler(c *gin.Context) {
+	result, err := s.xiaohongshuService.securityQR(c.Request.Context())
+	if err != nil {
+		respondError(c, 503, "SECURITY_QR_UNAVAILABLE", "无法准备安全验证二维码", nil)
+		return
+	}
+	respondSuccess(c, result, "安全验证")
+}
+func (s *AppServer) securityPollHandler(c *gin.Context) {
+	var req struct {
+		ID string `json:"id"`
+	}
+	if c.ShouldBindJSON(&req) != nil || req.ID == "" {
+		respondError(c, 400, "INVALID_REQUEST", "缺少验证会话", nil)
+		return
+	}
+	result, err := s.xiaohongshuService.securityPoll(c.Request.Context(), req.ID)
+	if err != nil {
+		respondError(c, 503, "SECURITY_CHECK_FAILED", "验证后搜索仍不可用，请稍后重试", nil)
+		return
+	}
+	respondSuccess(c, result, "安全验证状态")
+}
+func (s *AppServer) securityCancelHandler(c *gin.Context) {
+	var req struct {
+		ID string `json:"id"`
+	}
+	if c.ShouldBindJSON(&req) != nil || req.ID == "" {
+		respondError(c, 400, "INVALID_REQUEST", "缺少验证会话", nil)
+		return
+	}
+	v := &s.xiaohongshuService.security
+	v.mu.Lock()
+	if req.ID == v.id && v.status == "waiting" {
+		v.status = "expired"
+		v.closeLocked()
+	}
+	v.mu.Unlock()
+	respondSuccess(c, struct{}{}, "已停止等待")
+}
